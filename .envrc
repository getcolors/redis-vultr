# -*- mode: sh; sh-shell: bash -*-
export DIRENV_WARN_TIMEOUT=20s
eval "$(devenv direnvrc)"
use devenv 2>/dev/null

# Safe to commit: every credential lives in the gitignored .envrc.private.
# Missing credentials must not prevent credential-free builds or safe dry runs.
# Run `direnv allow` once after the toolchain is installed.
#
# Never export COLORS_PAR_PROFILE. It identifies this deployment and must come
# only from colors.yml.
source_env_if_exists .envrc.private

# The backup sets go to the langfuse-backup bucket, whose scoped token already
# exists as COLORS_PAR_LANGFUSE_BACKUP_R2_*. The redis package's play reads
# exactly COLORS_PAR_REDIS_BACKUP_R2_ACCESS_KEY_ID and
# COLORS_PAR_REDIS_BACKUP_R2_SECRET_ACCESS_KEY via lookup('env', ...) at
# execution time, and ansible-playbook inherits this environment -- so the
# pair is mapped across here: non-secret plumbing in a tracked file, with the
# values living only in the gitignored .envrc.private.
#
# Supplying a dedicated COLORS_PAR_REDIS_BACKUP_R2_* pair in .envrc.private
# takes precedence automatically.
: "${COLORS_PAR_REDIS_BACKUP_R2_ACCESS_KEY_ID:=${COLORS_PAR_LANGFUSE_BACKUP_R2_ACCESS_KEY_ID:-}}"
: "${COLORS_PAR_REDIS_BACKUP_R2_SECRET_ACCESS_KEY:=${COLORS_PAR_LANGFUSE_BACKUP_R2_SECRET_ACCESS_KEY:-}}"
export COLORS_PAR_REDIS_BACKUP_R2_ACCESS_KEY_ID COLORS_PAR_REDIS_BACKUP_R2_SECRET_ACCESS_KEY
